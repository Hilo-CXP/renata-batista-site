# Servidor
PORT=3000
NODE_ENV=development
# Em produção: NODE_ENV=production e SITE_URL=https://seu-dominio
SITE_URL=http://localhost:3000
# TRUST_PROXY=1 atrás de Railway/Render/nginx (padrão em production). Use 0 em acesso direto.
# TRUST_PROXY=1

# Segurança — em production o servidor recusa placeholder e senha de exemplo
JWT_SECRET=altere-este-segredo-com-32-caracteres-minimo
ADMIN_USERNAME=adminexemplo
ADMIN_PASSWORD=sua-senha-aqui

# E-mail SMTP (obrigatório para confirmação ao paciente e formulário de contato)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=pisicologaexemplo@gmail.com

# Dados públicos (opcional — sobrescreve server/config/practice.js)
# PRACTICE_EMAIL=contato@renatapsicoarte.com.br
# PRACTICE_HOURS=Seg–Sex: 8h às 20h · Sáb: 9h às 14h

# Consulta online: se vazio, a opção Online some do agendamento
# ONLINE_MEETING_LINK=https://meet.google.com/seu-link
